# Dokploy panel environment for deploy/dokploy/docker-compose.yml (dev).
# Generate the three secrets with: openssl rand -base64 32

CAL_IMAGE_TAG=au-v0.1.0
CAL_API_URL=https://cal-api.<dev-domain>

POSTGRES_USER=calendso
POSTGRES_PASSWORD=

JWT_SECRET=
NEXTAUTH_SECRET=
# Encrypts stored Google tokens (Credential table). NON-ROTATABLE in practice —
# generate once for dev and never reuse the prod value.
CALENDSO_ENCRYPTION_KEY=

# JSON of the DEV Google OAuth client:
# {"client_id":"...","client_secret":"...","redirect_uris":["https://cal-api.<dev-domain>/v2/gcal/oauth/save"]}
GOOGLE_API_CREDENTIALS=
